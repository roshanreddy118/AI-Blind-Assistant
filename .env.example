# AI Blind Assistant - Environment Configuration
# Copy this file to .env and fill in your API keys.
# All providers are tried in order as fallback.

# Option 1: Google Gemini (FREE - primary)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: OpenRouter (supports many models)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Option 3: Groq (fast inference)
# GROQ_API_KEY=your_groq_api_key_here

# Option 4: OpenAI GPT-4 Vision
# OPENAI_API_KEY=your_openai_api_key_here

# App Settings
APP_PORT=8000
DEFAULT_LANGUAGE=en
SCENE_INTERVAL_MS=3000
OBSTACLE_ALERT_DISTANCE=close
